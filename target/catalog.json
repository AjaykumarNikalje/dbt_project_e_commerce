der_summary as orders\n    on customers.customer_id = orders.customer_id\nTable Properties: [pipelines.pipelineId=d5e9335f-bdc2-4775-af54-ab65beffef66]\nSchema: root\n |-- customer_id: integer (nullable = true)\n |-- customer_name: string (nullable = true)\n |-- country: string (nullable = true)\n |-- segment: string (nullable = true)\n |-- total_orders: long (nullable = true)\n |-- completed_orders: long (nullable = true)\n |-- completed_sales_amount: decimal(28,2) (nullable = true)\n |-- cancelled_orders: long (nullable = true)\n |-- refunded_orders: long (nullable = true)\n |-- latest_order_at: timestamp (nullable = true)\n", "owner": null}, "columns": {"customer_id": {"type": "integer", "index": 0, "name": "customer_id", "comment": null}, "customer_name": {"type": "string", "index": 1, "name": "customer_name", "comment": null}, "country": {"type": "string", "index": 2, "name": "country", "comment": null}, "segment": {"type": "string", "index": 3, "name": "segment", "comment": null}, "total_orders": {"type": "bigint", "index": 4, "name": "total_orders", "comment": null}, "completed_orders": {"type": "bigint", "index": 5, "name": "completed_orders", "comment": null}, "completed_sales_amount": {"type": "decimal(28,2)", "index": 6, "name": "completed_sales_amount", "comment": null}, "cancelled_orders": {"type": "bigint", "index": 7, "name": "cancelled_orders", "comment": null}, "refunded_orders": {"type": "bigint", "index": 8, "name": "refunded_orders", "comment": null}, "latest_order_at": {"type": "timestamp", "index": 9, "name": "latest_order_at", "comment": null}}, "stats": {"has_stats": {"id": "has_stats", "label": "Has Stats?", "value": false, "include": false, "description": "Indicates whether there are statistics for this table"}}, "unique_id": "model.e_commerce.gld_customer_summary"}, "model.e_commerce.gld_daily_sales": {"metadata": {"type": "table", "schema": "dbt_retail_poc", "name": "gld_daily_sales", "database": "retail_analytics_poc", "comment": "Daily 